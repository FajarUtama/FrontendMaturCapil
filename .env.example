# Salin ke .env lokal: cp .env.example .env

# true = mock + localStorage | false = backend FastAPI
VITE_USE_MOCK_API=false

# Production (Railway)
VITE_API_BASE_URL=https://backendmaturcapil-production.up.railway.app/api/v1
VITE_UPLOADS_ORIGIN=https://backendmaturcapil-production.up.railway.app

# Development lokal (ganti jika pakai BE di mesin sendiri)
# VITE_API_BASE_URL=http://localhost:3000/api/v1
# VITE_UPLOADS_ORIGIN=http://localhost:3000

# Timeout request (ms)
VITE_API_TIMEOUT_MS=30000

# Polling chat REST (ms)
VITE_CHAT_POLL_MS=10000
